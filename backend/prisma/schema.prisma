// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
  SUPERADMIN
}

enum TableStatus {
  EMPTY
  OCCUPIED
  CLEANING
}

enum CouponType {
  PERCENT
  FIXED_AMOUNT
}

enum CouponCategory {
  ALL
  COFFEE
  BURGERS
  SNACKS
  DRINKS
}

enum BranchStatus {
  PENDING
  APPROVED
  SUSPENDED
}

model User {
  id                Int            @id @default(autoincrement())
  username          String         @unique
  email             String         @unique 
  password_hash     String
  role              Role           @default(CUSTOMER)
  full_name         String?
  membership_points Int            @default(0)
  phone_number      String?
  created_at        DateTime       @default(now()) 
  orders            Order[]
  paid_items        OrderItem[]    @relation("PaidBy")
  created_items     OrderItem[]    @relation("CreatedBy")
  is_guest          Boolean        @default(false)
  restaurant_id     Int?
  restaurant        Restaurant?    @relation(fields: [restaurant_id], references: [id])
  owned_restaurants Restaurant[]   @relation("AdminOwned")
  coupons           Coupon[]
}

model Restaurant {
  id                Int           @id @default(autoincrement())
  name              String
  admin_id          Int?           // The owner
  admin             User?          @relation("AdminOwned", fields: [admin_id], references: [id])
  staff             User[]         // Employees at this branch
  total_capacity    Int
  current_occupancy Int           @default(0)
  tables            Table[]
  menu_items        MenuItem[]
  inventory         InventoryItem[] 
  density_logs      DensityLog[]
  coupons           Coupon[]
  news_feeds        PromotionNews[]
  status BranchStatus @default(PENDING)
}

model Table {
  id            Int          @id @default(autoincrement())
  table_number  Int
  restaurant_id Int
  restaurant    Restaurant   @relation(fields: [restaurant_id], references: [id])
  status        TableStatus  @default(EMPTY)
  qr_code_id    String       @unique
  sessions      Session[]
}

model Session {
  id         Int       @id @default(autoincrement())
  table_id   Int
  table      Table     @relation(fields: [table_id], references: [id])
  join_code  String    @unique 
  is_active  Boolean   @default(true)
  start_time DateTime  @default(now())
  end_time   DateTime?
  orders     Order[]
}

model Order {
  id            Int          @id @default(autoincrement())
  customer_id   Int
  customer      User         @relation(fields: [customer_id], references: [id])
  session_id    Int
  session       Session      @relation(fields: [session_id], references: [id])
  restaurant_id Int
  status        String       @default("PENDING") 
  total_amount  Float        @default(0)
  created_at    DateTime     @default(now())
  items         OrderItem[]
  payments      Payment[]
  coupon_id     Int?
  coupon        Coupon?      @relation(fields: [coupon_id], references: [id])
}

model MenuItem {
  id              Int                  @id @default(autoincrement())
  restaurant_id   Int
  restaurant      Restaurant           @relation(fields: [restaurant_id], references: [id])
  name            String
  price           Float
  category        String               @default("COFFEE") // Dynamic string allows text entry injections
  image_name      String?              @default("default") // Matches your frontend asset dictionary keys
  order_items     OrderItem[]
  ingredients     MenuItemIngredient[]
  is_vegan        Boolean              @default(false)
  is_gluten_free  Boolean              @default(false)
  is_hot          Boolean              @default(false)  
  is_sweet        Boolean              @default(false)
  is_sour         Boolean              @default(false)
}

model OrderItem {
  id              Int      @id @default(autoincrement())
  order_id        Int
  order           Order    @relation(fields: [order_id], references: [id])
  item_id         Int
  item            MenuItem @relation(fields: [item_id], references: [id])
  quantity        Int      @default(1)
  paid_by_user_id Int?     
  paid_by         User?    @relation("PaidBy", fields: [paid_by_user_id], references: [id])
  created_by_user_id Int?
  created_by         User?   @relation("CreatedBy", fields: [created_by_user_id], references: [id])
  status          String?  @default("PENDING") 
  customization   String?  
}

model Payment {
  id       Int    @id @default(autoincrement())
  order_id Int
  order    Order  @relation(fields: [order_id], references: [id])
  method   String 
  status   String 
}

model Coupon {
  id              Int            @id @default(autoincrement())
  restaurant_id   Int?           
  restaurant      Restaurant?    @relation(fields: [restaurant_id], references: [id])
  admin_id        Int
  admin           User           @relation(fields: [admin_id], references: [id])
  code            String         @unique
  coupon_type     CouponType     @default(PERCENT)
  discount_value  Float          // Serves as raw percentage OR literal amount off
  min_cart_limit  Float          @default(0.0) // Minimum transaction value required
  applicable_to   CouponCategory @default(ALL) // Sector lock rules
  is_active       Boolean        @default(true)
  orders          Order[]
  usage_limit     Int            @default(9999) // Large fallback cap for legacy entries
  current_usage   Int            @default(0)
}

model DensityLog {
  id             Int        @id @default(autoincrement())
  restaurant_id  Int
  restaurant     Restaurant @relation(fields: [restaurant_id], references: [id])
  peak_occupancy Int
  recorded_at    DateTime   @default(now())
}

model InventoryItem {
  id              Int               @id @default(autoincrement())
  restaurant_id   Int
  restaurant      Restaurant        @relation(fields: [restaurant_id], references: [id])
  name            String      
  amount          Float       
  unit            String      
  min_limit       Float             @default(2.0) 
  used_in_items   MenuItemIngredient[] // ADDED THIS: Back-relation for recipes
}

model MenuItemIngredient {
  id           Int      @id @default(autoincrement())
  menuItemId   Int
  inventoryId  Int
  quantityUsed Float    

  menuItem     MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventory    InventoryItem @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@index([inventoryId])
}


model PromotionNews {
  id            Int        @id @default(autoincrement())
  restaurant_id Int
  restaurant    Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  title         String
  description   String
  image_tag     String     @default("default") // Maps to local visual accent illustrations
  created_at    DateTime   @default(now())
}